# Profile: VPN Client Certificate
# EKU: clientAuth + ipsecUser (1.3.6.1.5.5.7.3.7)

[ vpn_client ]
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid:always
basicConstraints        = critical,CA:false
keyUsage                = critical,digitalSignature
extendedKeyUsage        = clientAuth,1.3.6.1.5.5.7.3.7
crlDistributionPoints   = @crl_info
authorityInfoAccess     = @ocsp_issuer_info

[ crl_info ]
URI.0                   = ${ENV::CDP_URL}

[ ocsp_issuer_info ]
OCSP;URI.0              = ${ENV::OCSP_URL}
caIssuers;URI.0         = ${ENV::AIA_URL}
