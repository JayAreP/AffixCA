    "c":  { "required": false, "label": "Country", "maxLength": 2 }
  },
  "sanTypes": [],
  "sanRequired": false,
  "autoSanFromCN": false,
  "generateKey": true,
  "allowCSR": true,
  "opensslExtFile": "code-signing.cnf",
  "dynamicExt": false
}
