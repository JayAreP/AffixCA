{
  "id": "device-auth",
  "name": "Device Authentication",
  "description": "802.1x NAC, IoT device identity, MDM enrollment",
  "category": "device",
  "icon": "device",
  "color": "#8b5cf6",
  "ekus": ["clientAuth", "1.3.6.1.5.5.7.3.14"],
  "keyUsage": ["digitalSignature"],
  "critical": true,
  "maxDays": 730,
  "defaultDays": 365,
  "subjectFields": {
    "cn": { "required": true, "label": "Device Name / Serial", "placeholder": "switch-floor2-01" },
    "o":  { "required": false, "label": "Organization" },
    "ou": { "required": false, "label": "Department / Site" }
  },
  "sanTypes": ["DNS", "IP", "URI"],
  "sanRequired": false,
  "autoSanFromCN": false,
  "generateKey": true,
  "allowCSR": true,
  "opensslExtFile": "device-auth.cnf",
  "dynamicExt": false
}
