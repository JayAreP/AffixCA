{
  "id": "vpn-client",
  "name": "VPN Client",
  "description": "IPSec / IKEv2 VPN endpoint authentication",
  "category": "network",
  "icon": "vpn",
  "color": "#6366f1",
  "ekus": ["clientAuth", "1.3.6.1.5.5.7.3.7"],
  "keyUsage": ["digitalSignature"],
  "critical": true,
  "maxDays": 730,
  "defaultDays": 365,
  "subjectFields": {
    "cn": { "required": true, "label": "User or Device", "placeholder": "jsmith-laptop" },
    "o":  { "required": false, "label": "Organization" }
  },
  "sanTypes": ["DNS", "IP", "email"],
  "sanRequired": false,
  "autoSanFromCN": false,
  "generateKey": true,
  "allowCSR": true,
  "opensslExtFile": "vpn-client.cnf",
  "dynamicExt": false
}
