{
  "id": "vpn-server",
  "name": "VPN Server",
  "description": "VPN gateway / concentrator identity",
  "category": "network",
  "icon": "server",
  "color": "#4f46e5",
  "ekus": ["serverAuth", "1.3.6.1.5.5.7.3.17"],
  "keyUsage": ["digitalSignature", "keyEncipherment"],
  "critical": true,
  "maxDays": 825,
  "defaultDays": 365,
  "subjectFields": {
    "cn": { "required": true, "label": "VPN Gateway FQDN", "placeholder": "vpn.corp.example.com" },
    "o":  { "required": false, "label": "Organization" }
  },
  "sanTypes": ["DNS", "IP"],
  "sanRequired": true,
  "autoSanFromCN": true,
  "generateKey": true,
  "allowCSR": true,
  "opensslExtFile": "vpn-server.cnf",
  "dynamicExt": false
}
